## {term, text, see: Array} for a term (case-insensitive), or {} if unknown.
static func lookup(term: String) -> Dictionary:
	var key := term.strip_edges().to_lower()
	if not TERMS.has(key):
		return {}
	var d: Dictionary = TERMS[key]
	return {"term": key, "title": d.get("title", display(key)), "text": d.get("text", ""), "see": d.get("see", [])}


static func has(term: String) -> bool:
	return TERMS.has(term.strip_edges().to_lower())


## Sorted list of all terms.
static func all_terms() -> PackedStringArray:
	var out := PackedStringArray(TERMS.keys())
	out.sort()
	return out


## Display form of a term: its explicit title (proper nouns) or capitalised key.
static func display(term: String) -> String:
	var key := term.strip_edges().to_lower()
	if TERMS.has(key) and (TERMS[key] as Dictionary).has("title"):
		return str(TERMS[key]["title"])
	if term == "":
		return term
	return term.substr(0, 1).to_upper() + term.substr(1)
