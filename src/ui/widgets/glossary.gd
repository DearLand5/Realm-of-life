class_name Glossary
extends RefCounted
## Short explanations of biology / physics terms used in the UI (Russian).
## Keys are lower-case; `see` lists related terms shown as links in HelpPopup.
##
##   Glossary.lookup("Аллель")  → {term, title, text, see}   (case-insensitive; {} if unknown)

const TERMS := {
